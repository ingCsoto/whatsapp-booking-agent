# Required: from your Meta app (App settings > Basic > App secret) and a token you choose for the webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Optional: without these, replies are printed to the console instead of sent to WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: without it, intents are classified with deterministic rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

BUSINESS_NAME=Studio Demo
BUSINESS_HOURS=lunes a viernes, de 9:00 a 18:00
